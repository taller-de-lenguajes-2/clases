<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Cada vista pone su título en ViewData["Title"] *@
    <title>@ViewData["Title"] · Clínica</title>
    <link rel="stylesheet" href="~/css/sitio.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="marca" asp-controller="Home" asp-action="Index">Clínica</a>
        <nav>
            <a asp-controller="Pacientes" asp-action="Index">Pacientes</a>
            <a asp-controller="Medicos" asp-action="Index">Médicos</a>
            <a asp-controller="Turnos" asp-action="Index">Turnos</a>
            <a asp-controller="TiemposDeVida" asp-action="Index">Tiempos de vida</a>
        </nav>
        @* La vista también puede leer la sesión: Context es el HttpContext del request *@
        <div class="usuario">
            @if (Context.Session.GetString("Usuario") is string)
            {
                <span>Hola, @Context.Session.GetString("Nombre")</span>
                <form asp-controller="Login" asp-action="Salir" method="post">
                    <button type="submit" class="enlace">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Login" asp-action="Index">Ingresar</a>
            }
        </div>
    </header>

    <main>
        @* Acá se dibuja la vista que eligió el controlador *@
        @RenderBody()
    </main>

    <footer>
        Taller de Lenguajes 2 · FACET · @DateTime.Now.Year
    </footer>

    @* Scripts propios de cada vista; si una vista no los define, no pasa nada *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
